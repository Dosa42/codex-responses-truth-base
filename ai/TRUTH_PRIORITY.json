{
  "truth_order": [
    "upstream/openapi/openapi.yaml",
    "upstream/docs/",
    "schema/",
    "reference/",
    "artifacts/",
    "fixtures/"
  ],
  "rules": {
    "upstream_is_authoritative": true,
    "upstream_snapshots_are_unmodified": true,
    "derived_files_must_declare_source": true,
    "implementation_is_not_schema": true,
    "examples_are_not_authoritative": true,
    "missing_information_must_not_be_inferred": true,
    "project_architecture_must_not_be_invented": true
  }
}
